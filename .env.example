# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.

# Chave que assina o cookie de sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Perfil de persistência: mysql (produção/demonstração) ou memoria (sem banco)
PERSISTENCE_PROFILE=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=biblioteca_gof
# Banco usado SOMENTE pelos testes (as tabelas dele são apagadas a cada teste)
MYSQL_TEST_DATABASE=biblioteca_gof_teste

# Política de multa inicial: original | teto | tolerancia
POLITICA_MULTA=original
# Banco de cobrança da instalação: A | B
BANCO_COBRANCA=A

# Defina 1 quando o site estiver em HTTPS
SESSION_COOKIE_SECURE=0
